
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins have full access to everything.
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin';
    }

    // Any authenticated user can read company-wide data like settings and announcements.
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);

      match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
      }

       match /holidays/{holidayId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin(request.auth.uid);
      }
      
      // Users can only access data within their own company.
      function isUserInCompany() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      }
      
      match /attendanceLog/{logId} {
          allow read, write: if request.auth != null && isUserInCompany();
      }

      match /tasks/{taskId} {
         allow read, write: if request.auth != null && isUserInCompany();
      }
       match /leaveApplications/{leaveId} {
         allow read, write: if request.auth != null && isUserInCompany();
      }
       match /advances/{advanceId} {
         allow read, write: if request.auth != null && isUserInCompany();
      }
    }

    // Users can only read their own user document, but admins can read any.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin(request.auth.uid);
      allow write: if request.auth.uid == userId || isAdmin(request.auth.uid);
       // Allow new user creation for anyone (for signup)
      allow create: if true;
    }
    
    // Users can only manage their own links.
    match /links/{linkId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
