
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to manage their own categories
    match /categories/{categoryId} {
      allow read, write, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Allow users to manage their own links
    match /links/{linkId} {
      allow read, write, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Allow an authenticated user to create an attendance log for themselves
    match /companies/{companyId}/attendanceLog/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Allow admins to read company-wide data
    match /companies/{companyId}/{document=**} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fallback security rule for user-specific data that might not be covered above
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
