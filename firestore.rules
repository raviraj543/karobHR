rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection rules
    match /users/{userId} {
      // Allows queries to find user by employeeId for login (e.g., allow login form to search)
      allow list: if true;

      // Allow a user to GET their own document, and admins to GET any user's document.
      allow get: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Allow a user to WRITE to their own document (e.g., update profile, save FCM token)
      allow write: if request.auth.uid == userId;
    }

    // NEW: Explicit rules for the 'companies' collection
    match /companies/{companyId} {
      // Any authenticated user of the company can read the settings.
      allow read: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // ONLY an admin of the company can update the settings.
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // Disallow client-side creation/deletion of companies after initial setup
      allow create, delete: if false; 
    }

    // Rules for all other top-level collections
    match /{collection}/{docId} {
      // Authenticated users can read any document in these top-level collections
      allow read, create: if request.auth != null;
      allow update, delete: if false;

      // Nested rule for all subcollections (like 'announcements' under 'companies')
      match /{subCollection}/{subDocId} {
        // Authenticated users can read from any subcollection
        allow read, create: if request.auth != null;

        // Deny updates/deletes by default for subcollections
        allow update, delete: if false;
      }
    }
  }
}
