rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allows only authenticated users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allows authenticated users to manage their own categories
    match /categories/{categoryId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allows authenticated users to manage their own links
    match /links/{linkId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Rules for company-specific data
    match /companies/{companyId} {
        // Admins can read and update their own company settings.
        allow read, update: if request.auth != null && request.auth.uid == resource.data.adminUid;
        
        // Rules for attendance logs within a company
        match /attendanceLog/{logId} {
            // Users can create their own attendance logs.
            allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
            // Users can read their own attendance logs, and admins can read all logs for their company.
            allow read: if request.auth != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        }

        // Admins can manage all advances for their company.
        match /advances/{advanceId} {
           allow read, update, create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
        
        // Admins can manage all tasks for their company.
        match /tasks/{taskId} {
           allow read, update, create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }

        // Admins can manage all holidays for their company.
        match /holidays/{holidayId} {
           allow read, create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }

        // Admins can manage all announcements for their company.
        match /announcements/{announcementId} {
           allow read, create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
    }
  }
}
