rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection rules
    match /users/{userId} {
      // READ: A user can get their own doc, or an admin can get any doc.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // LIST: Only admins can list all users (for the employee management page).
      allow list: if isAdmin();
      
      // CREATE: Only an admin can create a new user document.
      allow create: if isAdmin();

      // UPDATE: A user can update their own doc, or an admin can update any doc.
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // DELETE: Only an admin can delete a user document.
      allow delete: if isAdmin();
    }

    // Rules for the 'companies' collection
    match /companies/{companyId} {
      // Any authenticated user of the company can read the settings.
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // ONLY an admin of the company can update the settings.
      allow update: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // Disallow client-side creation/deletion of companies after initial setup.
      allow create, delete: if false; 
    }

    // Rules for company subcollections (e.g., attendance, tasks)
    match /companies/{companyId}/{subCollection}/{docId} {
        // Any user belonging to the company can read and create documents here.
        // This covers attendance logs, tasks, announcements etc.
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

        // An admin can update any record (e.g., edit attendance).
        // A regular user can only update documents they created (e.g., their own task).
        allow update: if request.auth != null 
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                      && (isAdmin() || request.resource.data.userId == request.auth.uid);
        
        // Only admins can delete from subcollections.
        allow delete: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
  }
}
