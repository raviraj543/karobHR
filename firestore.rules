rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    // Users can read their own document.
    // Users can be created by anyone (for signup) but only the user can update their own info.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // CATEGORIES & LINKS (User-specific data)
    // Users can manage their own categories and links.
    match /categories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /links/{linkId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // COMPANIES & SUBCOLLECTIONS
    match /companies/{companyId} {
      // Any authenticated user who is part of the company can read the company settings.
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // Only the designated admin can create or update the company document.
      // For create: check the incoming resource.
      // For update: check the existing resource in the database.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.adminUid;
      allow update: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/companies/$(companyId)).data.adminUid;
      
      // ATTENDANCE LOG
      // Any authenticated user can create their own attendance log within their company.
      // They can also read their own logs.
      match /attendanceLog/{logId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow read, update: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/companies/$(companyId)/attendanceLog/$(logId)).data.userId;
      }
      
      // Other company subcollections (announcements, tasks, etc.)
      // Admins can manage these. Employees might have read access.
      match /announcements/{announcementId} {
        allow read: if request.auth != null; // All employees can read announcements
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      match /tasks/{taskId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /advances/{advanceId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null; // Allows both users to create and admins to update
      }

      match /holidays/{holidayId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }
  }
}