
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection.
    match /users/{userId} {
      // Allow public read access to user documents. This is necessary for
      // the login flow which looks up user details by employeeId/email before full auth is established.
      allow read: if true;
      
      // Allow a new user document to be created if an authenticated user creates their own document.
      // This is crucial for the signup process.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to update or delete only their own user document.
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // For all other documents (companies, announcements, attendance, tasks, leaves, advances, links, etc.),
    // allow read and write access only if the user is authenticated.
    // This simplifies permissions significantly, ensuring no blocking issues for logged-in users.
    // This rule does NOT apply to the 'users' collection because the specific rules above take precedence.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
